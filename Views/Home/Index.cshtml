@using System.Globalization
@model GECP_Front_End_Static.Models.HomePageModelVM
@{
	ViewData["Title"] = "Home Page";
	int newscount = Model.newsModelVM.Count();
	int currentYear = DateTime.Now.Year;
}

@* @Html.Partial("_slider",Model.masterSliderVM) *@
<div class="featured_section13">
	<div class="clearfix margin_top11"></div>
	@if (Model.marqueeModelVM != null && Model.marqueeModelVM.Any(x => x.isshow))
	{
		var activeItems = Model.marqueeModelVM.Where(x => x.isshow).ToList();

		<div class="marquee-container">
			<div class="marquee-track">

				@for (int i = 0; i < activeItems.Count; i++)
				{
					var item = activeItems[i];

					if (item.IsFile)
					{
						<a class="marquee-content" href="@Url.Content(item.FileLink)" target="_blank">
							@item.Title
						</a>
					}
					else if (!string.IsNullOrWhiteSpace(item.FileLink))
					{
						<a class="marquee-content" href="@item.FileLink" target="_blank">
							@item.Title
						</a>
					}
					else if (string.IsNullOrWhiteSpace(item.ActionName) && string.IsNullOrWhiteSpace(item.ControllerName))
					{
						<a class="marquee-content" href="@Url.Action("NEWSDetail", "Institute", new { @id = item.ID })">
							@item.Title
						</a>
					}
					else if (!string.IsNullOrWhiteSpace(item.dynamicID))
					{
						<a class="marquee-content" href="@Url.Action(item.ActionName, item.ControllerName, new { @id = item.dynamicID })">
							@item.Title
						</a>
					}
					else if (!string.IsNullOrWhiteSpace(item.dynamicID))
					{
						<a class="marquee-content" href="@Url.Action(item.ActionName, item.ControllerName, new { @id = item.dynamicID })">
							📄 @item.Title
						</a>
					}
					else
					{
						<a class="marquee-content" href="@Url.Action(item.ActionName, item.ControllerName)">
							@item.Title
						</a>
					}

					if (i < activeItems.Count - 1)
					{
						<span class="marquee-separator"> | </span>
					}
				}

			</div>
		</div>
	}

	<div class="clearfix"></div>

	<div class="full-container">

		<!-- 💡 CO-JOINED SPLIT GRID CONTAINER FOR SCREENSHOT LAYOUT -->
		<div class="bg-light">
			<div class="hero-split-showcase">

				<!-- Left Grid Pane: Injects Main Banner Slider component -->
				<div class="hero-main-slider-pane">
					@Html.Partial("_slider", Model.masterSliderVM)
				</div>

				<!-- Right Grid Pane: Notice Board Panel Box container -->
				<!-- Right Side: Notice Board Panel Box container with Horizontal Tabs -->
				<div class="updates_section hero-notice-board-pane">

					<!-- 💡 NEW: Horizontal Tab Navigation Bar Links -->
					<div class="notice-tab-header-row">
						<button class="notice-tab-btn active" onclick="switchNoticeTab(event, 'tab-updates')">Notice Board</button>
						<button class="notice-tab-btn" onclick="switchNoticeTab(event, 'tab-activities')">Activities</button>
					</div>

					<!-- 💡 TAB 1: Updates / Latest Shots Slider Frame Track -->
					<div id="tab-updates" class="notice-tab-pane active">
						<div style="min-height:530px;padding: 10px;">
							<div>
								<marquee scrollamount="3" direction="up" onMouseOver="this.stop()" onMouseOut="this.start()" style="min-height:520px;">
									<ul class="newssection">
										@if (Model.updateModelVM == null || !Model.updateModelVM.Any())
										{
											<li><strong>NO UPDATES FOUND</strong></li>
										}
										else
										{
											foreach (var item in Model.updateModelVM)
											{
												if (item.IsFile)
												{
													<li>
														<!-- Only shows badge if item.IsNew is true in JSON -->
														<a href="@Url.Content(item.FileLink)" target="_blank">@item.Title</a>
														@if (item.isNew)
														{
															<span class="badge-new">New</span>
														}

													</li>
												}
												else if (string.IsNullOrWhiteSpace(item.ActionName) && string.IsNullOrWhiteSpace(item.ControllerName))
												{
													<li>
														<!-- Only shows badge if item.IsNew is true in JSON -->
														<a href="@Url.Action("NEWSDetail", "Institute", new { @id = item.ID })">@item.Title</a>
														@if (item.isNew)
														{
															<span class="badge-new">New</span>
														}

													</li>
												}
												else if (!string.IsNullOrWhiteSpace(item.dynamicID))
												{
													<li>
														<a href="@Url.Action(item.ActionName, item.ControllerName, new { @id = item.dynamicID })">
															@item.Title
														</a>
														@if (item.isNew)
														{
															<span class="badge-new">New</span>
														}
													</li>
												}
												else
												{
													<li>
														<!-- Only shows badge if item.IsNew is true in JSON -->
														<a href="@Url.Action(item.ActionName, item.ControllerName)"> @item.Title </a>
														@if (item.isNew)
														{
															<span class="badge-new">New</span>
														}

													</li>
												}
											}
										}
									</ul>
								</marquee>
							</div>
						</div>
					</div>

					<!-- 💡 TAB 2: Dynamic Activities Running Marquee Container Track -->
					<div id="tab-activities" class="notice-tab-pane">
						<div style="min-height:530px; padding: 10px;">
							<marquee scrollamount="3" direction="up" onMouseOver="this.stop()" onMouseOut="this.start()" style="min-height:495px; height: 495px;">
								<ul class="newssection" style="list-style: none; padding-left: 0;">
									@if (Model.activitymarqueeModelVM == null || !Model.activitymarqueeModelVM.Any())
									{
										<li><strong>NO ACTIVITIES FOUND</strong></li>
									}
									else
									{
										foreach (var item in Model.activitymarqueeModelVM.Where(m => m.Year == currentYear).OrderByDescending(m => DateTime.ParseExact(m.EventDate, "dd-MM-yyyy", CultureInfo.InvariantCulture)).ToList())
										{
											if (string.IsNullOrWhiteSpace(item.ActionName) && string.IsNullOrWhiteSpace(item.ControllerName))
											{
												<li style="margin-bottom: 12px;"><a href="@Url.Action("Activities", "CampusCommittee", new { @id = item.ID })" target="_blank" style="color: red; font-weight: 600;">@item.Title</a></li>
											}
											else
											{
												<li style="margin-bottom: 12px;"><a href="@Url.Action(item.ActionName, item.ControllerName)" style="color: red; font-weight: 600;"> @item.Title </a></li>
											}
										}
									}
								</ul>
							</marquee>
							<div class="clearfix" style="margin-top: 5px; text-align: center;">
								<a href="@Url.Action("AllActivities", "CampusCommittee")" class="btn btn-success" style="padding: 4px 12px; font-size: 13px;">View All</a>
							</div>
						</div>
					</div>

				</div> <!-- End Hero Notice Board Pane -->

			</div> <!-- End Hero Split Showcase Grid Container -->


		</div>
	</div>
	<div class="clearfix margin_bottom5"></div>
	<div class="full-container">
		<div class="New_container">

			<!-- 1. Left Hand Side Component: Updates / Notice Board -->
			<div class="updates_section">
				<ul style="margin-bottom:0px;">
					<li class="tab-heading">Notable Alumni</li>
				</ul>
				<div id="AlumniCarousel" class="owl-carousel">
					@foreach (var item in Model.videoCarouselVMs)
					{
						if (item.isIframe)
