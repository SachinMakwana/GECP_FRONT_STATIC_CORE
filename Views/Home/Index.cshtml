}

@section master_slider {
	<script src="@Url.Content("~/js/modalwindow/jquery.simplePopup.js")" type="text/javascript"></script>
	<script type="text/javascript">
		$(document).ready(function () {

			$('.show1');
			$('#pop1').simplePopup();



		});
	</script>
	<script src="@Url.Content("~/js/masterslider/masterslider.min.js")"></script>
	<script type="text/javascript">
				(function ($) {
			"use strict";
			var slider = new MasterSlider();

			// 💡 ADD THIS: Tells MasterSlider to initialize the time tracking bar engine
			slider.control('timebar', {
				insertTo: '#progressBar', // Appends the dynamic moving line inside our track container
				color: '#ffb300'           // (Optional) You can change the line hex color directly here
			});

			// slider.control('arrows');
			// slider.control('bullets');

			slider.setup('masterslider', {
				width: 1400,
				height: 680,
				space: 0,
				speed: 45,
				layout: 'fillwidth',
				loop: true,
				preload: 0,
