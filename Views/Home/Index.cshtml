@using System.Globalization
@model GECP_Front_End_Static.Models.HomePageModelVM
@{
	ViewData["Title"] = "Home Page";
	int newscount = Model.newsModelVM.Count();
	int currentYear = DateTime.Now.Year;
}

@* @Html.Partial("_slider",Model.masterSliderVM) *@
<div class="featured_section13">
	<div class="clearfix margin_top11"></div>
	@if (Model.marqueeModelVM != null && Model.marqueeModelVM.Any(x => x.isshow))
	{
		var activeItems = Model.marqueeModelVM.Where(x => x.isshow).ToList();

		<div class="marquee-container">
			<div class="marquee-track">

				@for (int i = 0; i < activeItems.Count; i++)
				{
					var item = activeItems[i];

					if (item.IsFile)
					{
						<a class="marquee-content" href="@Url.Content(item.FileLink)" target="_blank">
							@item.Title
						</a>
					}
					else if (!string.IsNullOrWhiteSpace(item.FileLink))
					{
						<a class="marquee-content" href="@item.FileLink" target="_blank">
							@item.Title
						</a>
					}
					else if (string.IsNullOrWhiteSpace(item.ActionName) && string.IsNullOrWhiteSpace(item.ControllerName))
					{
						<a class="marquee-content" href="@Url.Action("NEWSDetail", "Institute", new { @id = item.ID })">
							@item.Title
						</a>
					}
					else if (!string.IsNullOrWhiteSpace(item.dynamicID))
					{
						<a class="marquee-content" href="@Url.Action(item.ActionName, item.ControllerName, new { @id = item.dynamicID })">
							@item.Title
						</a>
					}
					else if (!string.IsNullOrWhiteSpace(item.dynamicID))
					{
						<a class="marquee-content" href="@Url.Action(item.ActionName, item.ControllerName, new { @id = item.dynamicID })">
							📄 @item.Title
						</a>
					}
					else
					{
						<a class="marquee-content" href="@Url.Action(item.ActionName, item.ControllerName)">
							@item.Title
						</a>
					}

					if (i < activeItems.Count - 1)
					{
						<span class="marquee-separator"> | </span>
					}
				}

			</div>
		</div>
	}

	<div class="clearfix"></div>

	<div class="full-container">

		<!-- 💡 CO-JOINED SPLIT GRID CONTAINER FOR SCREENSHOT LAYOUT -->
		<div class="bg-light">
			<div class="hero-split-showcase">

				<!-- Left Grid Pane: Injects Main Banner Slider component -->
				<div class="hero-main-slider-pane">
					@Html.Partial("_slider", Model.masterSliderVM)
				</div>

				<!-- Right Grid Pane: Notice Board Panel Box container -->
				<!-- Right Side: Notice Board Panel Box container with Horizontal Tabs -->
				<div class="updates_section hero-notice-board-pane">

					<!-- NEW: Horizontal Tab Navigation Bar Links -->
					<div class="notice-tab-header-row">
						<button class="notice-tab-btn active" onclick="switchNoticeTab(event, 'tab-updates')">Notice Board</button>
						<button class="notice-tab-btn" onclick="switchNoticeTab(event, 'tab-activities')">Activities</button>
					</div>

					<!-- TAB 1: Updates / Latest Shots Slider Frame Track -->
					<div id="tab-updates" class="notice-tab-pane active">
						<div style="min-height:530px;padding: 10px;">
							<div>
								<marquee scrollamount="3" direction="up" onMouseOver="this.stop()" onMouseOut="this.start()" style="min-height:520px;">
									<ul class="newssection">
										@if (Model.updateModelVM == null || !Model.updateModelVM.Any())
										{
											<li><strong>NO UPDATES FOUND</strong></li>
										}
										else
										{
											foreach (var item in Model.updateModelVM.Where(m => m.isshow == true).ToList())
											{
												if (item.IsFile)
												{
													<li>
														<!-- Only shows badge if item.IsNew is true in JSON -->
														<a href="@Url.Content(item.FileLink)" target="_blank">@item.Title</a>
														@if (item.isNew)
														{
															<span class="badge-new">New</span>
														}

													</li>
												}
												else if (string.IsNullOrWhiteSpace(item.ActionName) && string.IsNullOrWhiteSpace(item.ControllerName))
												{
													<li>
														<!-- Only shows badge if item.IsNew is true in JSON -->
														<a href="@Url.Action("NEWSDetail", "Institute", new { @id = item.ID })">@item.Title</a>
														@if (item.isNew)
														{
															<span class="badge-new">New</span>
														}

													</li>
												}
												else if (!string.IsNullOrWhiteSpace(item.dynamicID))
												{
													<li>
														<a href="@Url.Action(item.ActionName, item.ControllerName, new { @id = item.dynamicID })">
															@item.Title
														</a>
														@if (item.isNew)
														{
															<span class="badge-new">New</span>
														}
													</li>
												}
												else
												{
													<li>
														<!-- Only shows badge if item.IsNew is true in JSON -->
														<a href="@Url.Action(item.ActionName, item.ControllerName)"> @item.Title </a>
														@if (item.isNew)
														{
															<span class="badge-new">New</span>
														}

													</li>
												}
											}
										}
									</ul>
								</marquee>
							</div>
						</div>
					</div>

					<!-- TAB 2: Dynamic Activities Running Marquee Container Track -->
					<div id="tab-activities" class="notice-tab-pane">
						<div style="min-height:530px; padding: 10px;">
							<marquee scrollamount="3" direction="up" onMouseOver="this.stop()" onMouseOut="this.start()" style="min-height:495px; height: 495px;">
								<ul class="newssection" style="list-style: none; padding-left: 0;">
									@if (Model.activitymarqueeModelVM == null || !Model.activitymarqueeModelVM.Any())
									{
										<li><strong>NO ACTIVITIES FOUND</strong></li>
									}
									else
									{
										foreach (var item in Model.activitymarqueeModelVM.Where(m => m.Year == currentYear).OrderByDescending(m => DateTime.ParseExact(m.EventDate, "dd-MM-yyyy", CultureInfo.InvariantCulture)).ToList())
										{
											if (string.IsNullOrWhiteSpace(item.ActionName) && string.IsNullOrWhiteSpace(item.ControllerName))
											{
												<li style="margin-bottom: 12px;"><a href="@Url.Action("Activities", "CampusCommittee", new { @id = item.ID })" target="_blank" style="color: red; font-weight: 600;">@item.Title</a></li>
											}
											else
											{
												<li style="margin-bottom: 12px;"><a href="@Url.Action(item.ActionName, item.ControllerName)" style="color: red; font-weight: 600;"> @item.Title </a></li>
											}
										}
									}
								</ul>
							</marquee>
							<div class="clearfix" style="margin-top: 5px; text-align: center;">
								<a href="@Url.Action("AllActivities", "CampusCommittee")" class="btn btn-success" style="padding: 4px 12px; font-size: 13px;">View All</a>
							</div>
						</div>
					</div>

				</div> <!-- End Hero Notice Board Pane -->

			</div> <!-- End Hero Split Showcase Grid Container -->


		</div>
	</div>
	<div class="clearfix "></div>
	<div class="full-container notable-alumni-section">
		<div class="New_container">

			<!-- 1. Left Hand Side Component: Updates / Notice Board -->
			<div class="updates_section">
				<ul style="margin-bottom:0px;">
					<li class="tab-heading">Notable Alumni</li>
				</ul>
				<div id="AlumniCarousel" class="owl-carousel">
					@foreach (var item in Model.videoCarouselVMs)
					{
						if (item.isIframe)
						{
							<div class="carousel-slide-item type-video">
								<div class="carousel-video-wrapper">@Html.Raw(item.iFrame)</div>
								<div class="carousel-caption">@item.Title</div>
							</div>
						}
						else if (!string.IsNullOrWhiteSpace(item.Image))
						{
							<div class="carousel-slide-item type-image">
								<img src="@Url.Content(item.Image)" alt="" class="rimg">
								<div class="carousel-caption">@item.Title</div>
							</div>
						}
					}
				</div>
			</div>

			<!-- 2. 💡 THE FIX: Changed class from "one_half" to "center_icons_section" -->
			<div class="center_icons_section">
				<div class="icon_grid_box">
					<img src="@Url.Content("~/images/Home/icon1.jpg")" alt="" class="cirimg animate" data-anim-type="zoomIn" data-anim-delay="100" />
					<h4 class="color2">Five UG Engineering Programs</h4>
				</div>

				<div class="icon_grid_box">
					<img src="@Url.Content("~/images/Home/icon2.jpg")" alt="" class="cirimg animate" data-anim-type="zoomIn" data-anim-delay="200" />
					<h4 class="color2">Well Qualified Faculties</h4>
				</div>

				<div class="icon_grid_box">
					<img src="@Url.Content("~/images/Home/icon3.jpg")" alt="" class="cirimg animate" data-anim-type="zoomIn" data-anim-delay="300" />
					<h4 class="color2">Center of Excellence</h4>
				</div>

				<div class="icon_grid_box">
					<img src="@Url.Content("~/images/Home/icon4.jpg")" alt="" class="cirimg animate" data-anim-type="zoomIn" data-anim-delay="400" />
					<h4 class="color2">Holistic Development of Students</h4>
				</div>
			</div>

			<!-- 3. Right Hand Side Component: Latest Shots Panel -->
			<div class="updates_section">
				<ul style="margin-bottom:0px;">
					<li class="tab-heading">Latest Shots</li>
				</ul>
				<div id="VideoCarousel" class="owl-carousel">
					@foreach (var item in Model.videoCarouselVMs)
					{
						if (item.isIframe)
						{
							<div class="carousel-slide-item type-video">
								<div class="carousel-video-wrapper">@Html.Raw(item.iFrame)</div>
								<div class="carousel-caption">@item.Title</div>
							</div>
						}
						else if (!string.IsNullOrWhiteSpace(item.Image))
						{
							<div class="carousel-slide-item type-image">
								<img src="@Url.Content(item.Image)" alt="" class="rimg">
								<div class="carousel-caption">@item.Title</div>
							</div>
						}
					}
				</div>
			</div>

		</div>

	</div>
</div>
<!-- end featured section 13 -->
<div class="clearfix"></div>
<!-- NEW MERGED ROW CONTAINER: Principal Message (Left) + Vision/Mission (Right) -->
<div class="full-container info-showcase-split-row">

	<!-- ==================== LEFT HAND SIDE: PRINCIPAL CARD ==================== -->
	<div class="principal-message-card-pane">
		<div class="principal-card-flex-wrapper">

			<!-- Left Sub-Column: Image & Credentials -->
			<div class="principal-meta-col">
				<div class="principalimage">
					<img src="@Url.Content(Model.aboutUsVM.PrincipalPhoto)" alt="Principal Photo" />
				</div>
				<h4 class="principalname">@Model.aboutUsVM.PrincipalName</h4>
				<p class="principaldesignation">@Model.aboutUsVM.PrincipalDesignation</p>
				<p class="principaldesignations">Government Engineering College, Patan</p>
			</div>

			<!-- Right Sub-Column: Message Content Paragraph -->
			<div class="principal-text-col">
				<div class="principalmessage">
					<h2 class="mb-3">Message from the Principal</h2>
					<div class="border-left pl-3" style="border-color: #4f75ba;">
						<p style="text-align: justify; font-size: 14px; line-height: 22px;">
							@Model.aboutUsVM.PrincipalMessage
						</p>
					</div>
				</div>
			</div>

		</div>
	</div>

	<!-- ==================== RIGHT HAND SIDE: VISION & MISSION ==================== -->
	<div class="vision-mission-card-pane">

		<!-- Top Block: Vision Block -->
		<div class="vision-segment-box stcode_title4">
			<h3><span class="text"><i class="fa fa-institution" aria-hidden="true"></i><strong> VISION</strong></span></h3>
			@foreach (var item in @Model.aboutUsVM.Vision)
			{
				<p class="text-justify" style="font-size: 15px; margin-top: 8px;">
					@item
				</p>
			}
		</div>

		<!-- Bottom Block: Mission Block -->
		<div class="mission-segment-box stcode_title4" style="margin-top: 20px;">
			<h3><span class="text"><i class="fa fa-mortar-board" aria-hidden="true"></i><strong> MISSION</strong></span></h3>
			<ul class="text-justify" style="list-style: none; padding-left: 0; margin-top: 8px;">
				@foreach (var item in @Model.aboutUsVM.Mission)
				{
					<li style="margin-bottom: 8px; display: flex; align-items: flex-start; gap: 8px; font-size: 14px; line-height: 20px;">
						<i class="fa fa-toggle-on" aria-hidden="true" style="color: #4f75ba; margin-top: 3px;"></i>
						<span>@item</span>
					</li>
				}
			</ul>
		</div>

	</div>

</div> <!-- End Info Showcase Split Row -->

<div class="clearfix"></div>


<!-- end featured section 14 -->
<div class="clearfix"></div>
<!-- 6. Academic Departments Layout Block Links -->
@if (Model.aboutUsVM.Departments.Count() > 0)
{
	<div class="featured_section16">
		<div class="full-container">

			<h1 class="caps text-center">Departments</h1>

			<!-- 💡 Added structural class 'departments-flex-row' to handle alignment -->
			<div class="box departments-flex-row">
				@foreach (var item in Model.aboutUsVM.Departments.OrderBy(m => m.DepartmentID).ToList())
				{
					<a href="@Url.Action("DepartmentDetails", "Department", new { @id = item.DepartmentID })">
						<div class="hexagon one animate" data-anim-type="spinLeft" data-anim-delay="300">
							<i class="@item.Icon"></i>
							<h6>@item.ProgramName</h6>
						</div>
					</a>
				}
			</div>

		</div>
	</div>
}

@if (Model.TopRecruiters.Count() > 0)
{
	<div class="clearfix "></div>
	<div class="full-container top-recruiter-section">

		<h1 class="caps text-center">
			TOP RECRUITERS
		</h1>
		<div class="clearfix"></div>
		<div class="owl-carousel owl-theme" id="owl-demo">
			@foreach (var item in Model.TopRecruiters)
			{
				<div class="item">
					<div class="recruiter-logo-card">
						<img src="@Url.Content(item.LogoPath)" alt="">
					</div>
				</div>
			}
		</div>
	</div>
}


